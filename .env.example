# Firebase credentials — fill these in from your own Firebase project.
# Copy this file to .env and replace the placeholder values.
# NEVER commit the real .env file (it is in .gitignore).

# Path to your Firebase Admin SDK service account JSON key.
# Get it from Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_KEY_PATH=C:/path/to/your/traumasence-firebase-adminsdk-xxxx.json
