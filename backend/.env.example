# TraumaSense backend environment variables
# Copy to .env only if you need to override defaults.
# The prototype runs with these defaults out of the box.

# Speech-to-text provider: "demo" or a real provider identifier.
STT_PROVIDER=demo

# AI analysis provider: "demo" or a real provider identifier.
AI_PROVIDER=demo

# Maximum upload size in megabytes.
MAX_UPLOAD_SIZE_MB=50

# Default language hint for STT (ISO 639-1 where practical).
# DEFAULT_LANGUAGE=en
